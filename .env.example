# Copie para .env e preencha. O .env e a pasta data/ nunca devem ser publicados.

PORT=3100

# ---------- Supabase ----------

# No painel do Supabase: botao "Connect", copie a URI e troque [YOUR-PASSWORD] pela senha do banco.
# Sem esta linha o sistema usa um Postgres local em data/ (so para testes).
# Conexao direta (so IPv6):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.SEU-PROJETO.supabase.co:5432/postgres
# Pooler (IPv4), para maquinas ou servidores sem IPv6:
# DATABASE_URL=postgresql://postgres.SEU-PROJETO:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Fotos de perfil (Supabase Storage, bucket privado fotos-perfil, criado sozinho pela migração).
# Chave secreta de servidor: painel do Supabase > Project Settings > API Keys > "secret" (ou service_role).
# NUNCA publique esta chave nem coloque no código. Sem ela, com banco do Supabase, inserir foto fica indisponível;
# com banco local (sem DATABASE_URL), as fotos vão para data/fotos.
# O endereço do Storage sai do DATABASE_URL; SUPABASE_URL só se precisar forçar outro.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Na Vercel, o Preview (Dev) usa SUPABASE_SERVICE_ROLE_KEY_Dev (chave do projeto de dev).

# Opcional: certificado baixado em Database > Settings > SSL Configuration, para conferir o servidor.
# DATABASE_CA_FILE=

# Ligue quando o sistema estiver publicado com https (o cookie de sessao passa a exigir https).
# NODE_ENV=production
